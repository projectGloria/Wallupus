<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only for the window; Compose Material3 draws everything else.
         Avoids pulling in the whole appcompat/MDC View-system dependency. -->
    <style name="Theme.Wallupus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
